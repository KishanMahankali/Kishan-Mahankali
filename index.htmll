<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Kishan Mahankali — AI & ML engineering student portfolio">
<title>Kishan Mahankali | Future in Progress</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#070910;--panel:#101522;--text:#eef3ff;--muted:#9ba7bd;--cyan:#69f0f0;--violet:#9a7bff;--line:rgba(145,170,220,.18)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-3;background:radial-gradient(ellipse at 15% 15%,rgba(51,77,153,.22),transparent 38%),radial-gradient(ellipse at 85% 70%,rgba(112,55,180,.17),transparent 36%),#070910}
#starfield{position:fixed;inset:0;z-index:-2;pointer-events:none;background-image:radial-gradient(1px 1px at 20px 30px,#fff 99%,transparent),radial-gradient(1px 1px at 110px 90px,#9bcaff 99%,transparent),radial-gradient(2px 2px at 190px 40px,#fff 99%,transparent);background-size:230px 170px;opacity:.42;animation:drift 70s linear infinite}
@keyframes drift{to{transform:translateY(-170px)}}
a{color:inherit;text-decoration:none}
button{font:inherit}
.topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:17px 7%;background:rgba(7,9,16,.82);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.brand{font-family:'DM Mono',monospace;font-size:14px;letter-spacing:2px;color:var(--cyan)}
.brand span{color:var(--muted)}
.nav{display:flex;gap:26px;align-items:center}
.nav a{font-size:13px;color:var(--muted);transition:.25s}
.nav a:hover,.nav a.active{color:var(--cyan)}
.menu{display:none;background:none;color:white;border:1px solid var(--line);border-radius:8px;padding:7px 10px}
.page{display:none;min-height:82vh;padding:85px 9% 95px;animation:appear .55s ease}
.page.active{display:block}
@keyframes appear{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.kicker{font:11px 'DM Mono',monospace;letter-spacing:3px;text-transform:uppercase;color:var(--cyan);margin-bottom:20px}
.hero{min-height:76vh;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:55px}
.hero h1{font-size:clamp(48px,7vw,88px);line-height:.98;letter-spacing:-4px;margin-bottom:22px}
.hero h1 em{font-style:normal;color:var(--cyan);text-shadow:0 0 32px rgba(105,240,240,.25)}
.hero-copy{max-width:610px;color:var(--muted);font-size:16px;line-height:1.85}
.hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 19px;border:1px solid rgba(105,240,240,.5);border-radius:7px;color:var(--cyan);font:12px 'DM Mono',monospace;letter-spacing:.5px;transition:.25s}
.btn.primary{background:var(--cyan);color:#061014;font-weight:500}
.btn:hover{transform:translateY(-3px);box-shadow:0 0 28px rgba(105,240,240,.16)}
.orbit-wrap{display:grid;place-items:center;min-height:350px;position:relative}
.orbit{width:min(310px,70vw);aspect-ratio:1;border:1px solid rgba(105,240,240,.35);border-radius:50%;position:relative;box-shadow:0 0 70px rgba(94,105,255,.12),inset 0 0 60px rgba(105,240,240,.04);animation:rotate 28s linear infinite}
.orbit:before,.orbit:after{content:"";position:absolute;border:1px solid rgba(154,123,255,.4);border-radius:50%;inset:13%;transform:rotate(55deg) scaleX(1.7)}
.orbit:after{inset:25%;transform:rotate(-40deg) scaleX(1.8);border-color:rgba(105,240,240,.35)}
@keyframes rotate{to{transform:rotate(360deg)}}
.core{position:absolute;width:95px;height:95px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e8ffff,#69f0f0 18%,#4e5bc6 58%,#17152e 78%);box-shadow:0 0 55px rgba(105,240,240,.5)}
.orbit-label{position:absolute;bottom:8px;font:10px 'DM Mono',monospace;color:var(--muted);letter-spacing:2px}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:38px}
.section-head h2{font-size:clamp(32px,5vw,52px);letter-spacing:-2px}
.section-head p{font:11px 'DM Mono',monospace;color:var(--muted)}
.panel{background:linear-gradient(145deg,rgba(18,25,42,.9),rgba(11,15,26,.9));border:1px solid var(--line);border-radius:14px;padding:26px;transition:.25s}
.panel:hover{border-color:rgba(105,240,240,.42);transform:translateY(-3px)}
.panel h3{font-size:18px;margin-bottom:12px}
.panel p{color:var(--muted);line-height:1.8;font-size:14px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
.about-lead{font-size:clamp(20px,3vw,29px);line-height:1.5;max-width:850px;margin-bottom:25px}
.about-lead span{color:var(--cyan)}
.tag{display:inline-block;font:10px 'DM Mono',monospace;color:var(--cyan);border:1px solid rgba(105,240,240,.25);padding:6px 9px;border-radius:4px;margin:5px 5px 0 0}
.timeline{border-left:1px solid rgba(105,240,240,.45);margin:15px 0 0 8px;padding-left:26px}
.edu{position:relative;padding:0 0 30px}
.edu:before{content:"";position:absolute;left:-32px;top:5px;width:10px;height:10px;background:var(--cyan);border-radius:50%;box-shadow:0 0 15px var(--cyan)}
.edu .place{font-size:19px;margin-bottom:6px}
.edu .location{font:11px 'DM Mono',monospace;color:var(--cyan);margin-bottom:8px}
.edu p{font-size:13px;color:var(--muted);line-height:1.7}
.skill-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.skill{padding:16px;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.018)}
.skill strong{display:block;font-size:14px;margin-bottom:5px}
.skill small{font-size:12px;color:var(--muted);line-height:1.6}
.project-note{max-width:760px;padding:35px;border:1px solid rgba(105,240,240,.25);border-radius:14px;background:linear-gradient(130deg,rgba(105,240,240,.07),rgba(154,123,255,.06))}
.project-note .symbol{font:44px 'DM Mono',monospace;color:var(--cyan);margin-bottom:18px}
.project-note h3{font-size:25px;margin-bottom:12px}
.project-note p{color:var(--muted);line-height:1.85}
.contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.contact-card{padding:22px;border:1px solid var(--line);border-radius:12px;background:rgba(16,21,34,.8)}
.contact-card small{font:10px 'DM Mono',monospace;color:var(--cyan);letter-spacing:2px}
.contact-card p,.contact-card a{display:block;margin-top:12px;font-size:14px;overflow-wrap:anywhere}
.contact-card a:hover{color:var(--cyan)}
footer{padding:24px 7%;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:15px;color:var(--muted);font:10px 'DM Mono',monospace;letter-spacing:1px}
@media(max-width:800px){.hero{grid-template-columns:1fr;text-align:center;gap:20px}.hero-copy{margin:auto}.hero-actions{justify-content:center}.orbit-wrap{min-height:270px}.orbit{width:230px}.nav{display:none;position:absolute;top:62px;left:0;right:0;padding:20px;background:#0a0e19;border-bottom:1px solid var(--line);flex-direction:column;gap:18px}.nav.open{display:flex}.menu{display:block}.grid,.contact-grid{grid-template-columns:1fr}.page{padding:65px 7%}.section-head{align-items:start;flex-direction:column}}
@media(max-width:440px){.hero h1{letter-spacing:-2px}.skill-list{grid-template-columns:1fr}footer{flex-direction:column}}
</style>
</head>
<body>
<div id="starfield"></div>
<header class="topbar">
  <a class="brand" href="#home">KM<span> / PORTFOLIO</span></a>
  <button class="menu" id="menuBtn" aria-label="Open navigation">☰</button>
  <nav class="nav" id="nav">
    <a href="#home" class="active">HOME</a>
    <a href="#about">ABOUT</a>
    <a href="#education">EDUCATION & SKILLS</a>
    <a href="#projects">PROJECTS</a>
    <a href="#contact">CONTACT</a>
  </nav>
</header>

<main>
<section class="page active" id="home">
  <div class="hero">
    <div>
      <div class="kicker">01 — Welcome to my digital universe</div>
      <h1>KISHAN<br><em>MAHANKALI.</em></h1>
      <p class="hero-copy">Engineering student. Curious mind. Future-focused thinker. I’m beginning my journey in Artificial Intelligence and Machine Learning, exploring how technology can turn bold ideas into meaningful solutions.</p>
      <div class="hero-actions">
        <a class="btn primary" href="#about">EXPLORE MY WORLD ↗</a>
        <a class="btn" href="#contact">LET’S CONNECT</a>
      </div>
    </div>
    <div class="orbit-wrap" aria-label="Abstract animated orbital design">
      <div class="orbit"></div><div class="core"></div>
      <div class="orbit-label">LEARNING • BUILDING • EVOLVING</div>
    </div>
  </div>
</section>

<section class="page" id="about">
  <div class="section-head"><div><div class="kicker">02 — The person behind the screen</div><h2>ABOUT ME<span style="color:var(--cyan)">.</span></h2></div><p>IDENTITY / MINDSET</p></div>
  <p class="about-lead">I’m <span>Kishan Mahankali</span> — a first-year engineering student at BGS College of Engineering and Technology, beginning my journey in AI & ML.</p>
  <div class="grid">
    <article class="panel"><h3>My curiosity</h3><p>I enjoy discovering how things work, learning new technologies, exploring creative ideas and understanding the possibilities of artificial intelligence.</p></article>
    <article class="panel"><h3>My direction</h3><p>My goal is to build a strong foundation in programming, mathematics and problem-solving, then apply that knowledge to useful real-world projects.</p></article>
    <article class="panel"><h3>What I value</h3><p>Consistency, curiosity, creativity, teamwork and the willingness to learn from mistakes.</p></article>
    <article class="panel"><h3>Outside the classroom</h3><p>I’m interested in technology, space and science, digital creativity and exploring new ideas.</p></article>
  </div>
</section>

<section class="page" id="education">
  <div class="section-head"><div><div class="kicker">03 — My learning pathway</div><h2>EDUCATION<span style="color:var(--cyan)"> & </span>SKILLS.</h2></div><p>FOUNDATIONS / GROWTH</p></div>
  <div class="grid">
    <article class="panel"><h3>Education</h3><div class="timeline">
      <div class="edu"><div class="place">BGS College of Engineering and Technology</div><div class="location">BENGALURU, KARNATAKA</div><p>Currently pursuing engineering in Artificial Intelligence and Machine Learning.</p></div>
      <div class="edu"><div class="place">AKR Devi Memorial PU College</div><div class="location">SRIRAMNAGAR, GANGAVATHI, KOPPAL</div><p>Pre-university education.</p></div>
      <div class="edu"><div class="place">SFS High School</div><div class="location">MUNDARGI, GADAG</div><p>School education.</p></div>
    </div></article>
    <article class="panel"><h3>Skills I’m developing</h3><p style="margin-bottom:18px">As an AI & ML student, I’m building a beginner-friendly foundation across these areas. This list represents learning goals, not claims of expert-level proficiency.</p>
      <div class="skill-list">
        <div class="skill"><strong>Python fundamentals</strong><small>Variables, data types, conditions and loops</small></div>
        <div class="skill"><strong>C programming basics</strong><small>Logic, operators, functions and problem-solving</small></div>
        <div class="skill"><strong>HTML & CSS</strong><small>Webpage structure, styling and responsive design</small></div>
        <div class="skill"><strong>AI & ML awareness</strong><small>Understanding AI concepts and machine-learning basics</small></div>
        <div class="skill"><strong>Mathematical thinking</strong><small>Basic algebra, statistics and logical reasoning</small></div>
        <div class="skill"><strong>Digital productivity</strong><small>Internet research, presentations and documentation</small></div>
        <div class="skill"><strong>Git & GitHub</strong><small>Learning version control and project publishing</small></div>
        <div class="skill"><strong>Soft skills</strong><small>Communication, teamwork, adaptability and time management</small></div>
      </div>
    </article>
  </div>
</section>

<section class="page" id="projects">
  <div class="section-head"><div><div class="kicker">04 — Work in progress</div><h2>PROJECTS<span style="color:var(--cyan)">.</span></h2></div><p>IDEAS → EXPERIMENTS → IMPACT</p></div>
  <div class="project-note">
    <div class="symbol">[ 0x01 ]</div>
    <h3>Every great project starts with a first step.</h3>
    <p>I’m currently at the beginning of my engineering journey and focusing on learning the fundamentals. I haven’t completed my projects yet, but I’m excited to turn what I learn into practical work. This section will grow as I complete projects, experiments and certifications. Check back soon for updates.</p>
    <div style="margin-top:20px"><span class="tag">LEARNING PHASE</span><span class="tag">MORE COMING SOON</span></div>
  </div>
</section>

<section class="page" id="contact">
  <div class="section-head"><div><div class="kicker">05 — Open a connection</div><h2>LET’S CONNECT<span style="color:var(--cyan)">.</span></h2></div><p>IDEAS ARE BETTER WHEN SHARED</p></div>
  <p class="hero-copy" style="margin-bottom:30px">Have an idea, want to collaborate, or simply want to connect? Feel free to reach out through the channels below.</p>
  <div class="contact-grid">
    <div class="contact-card"><small>EMAIL</small><a href="mailto:kishan272008@gmail.com">kishan272008@gmail.com</a></div>
    <div class="contact-card"><small>PHONE</small><a href="tel:+919902694637">+91 99026 94637</a></div>
    <div class="contact-card"><small>INSTAGRAM</small><a href="https://www.instagram.com/m_called_kishan/" target="_blank" rel="noopener noreferrer">@m_called_kishan ↗</a></div>
  </div>
  <p style="margin-top:25px;color:var(--muted);font:11px 'DM Mono',monospace">BGS COLLEGE OF ENGINEERING AND TECHNOLOGY · AI & ML</p>
</section>
</main>

<footer><span>© 2026 KISHAN MAHANKALI</span><span>DESIGNED FOR THE FUTURE — BUILT ONE STEP AT A TIME</span></footer>

<script>
const pages=[...document.querySelectorAll('.page')];
const links=[...document.querySelectorAll('.nav a')];
const nav=document.getElementById('nav');
function navigate(){
  let id=location.hash.slice(1)||'home';
  if(!pages.some(p=>p.id===id)) id='home';
  pages.forEach(p=>p.classList.toggle('active',p.id===id));
  links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+id));
  nav.classList.remove('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
window.addEventListener('hashchange',navigate);
document.getElementById('menuBtn').addEventListener('click',()=>nav.classList.toggle('open'));
links.forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));
navigate();
</script>
</body>
</html>
